#!/usr/bin/env bash
# check_join_eo -- is that repository ready to join the Eunoia ecosystem, already
# in it, or claiming to be without backing the claim?
#
# Run it here, in kanon, pointed at somebody else's checkout. The counterpart is
# prompts/join_eo, which runs in *their* repository and does the joining.
#
#   check_join_eo ethos             # by repo id, or by path
#   check_join_eo --show-prompt eo  # print the prompt and exit
#
# Runs the policy checker, then asks for a read-only assessment of the README.
# Resolves a path, scripts/repos.local, $ANOIEU_REPOS, siblings, then $HOME.

set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
REPOS_FILE="${ANOIEU_REPOS_FILE:-$HERE/../scripts/repos.local}"
AGENT=claude
PRINT=0
SHOW=0
NAME=""

usage() {
  cat >&2 <<'USAGE'
usage: check_join_eo [--codex] [--print] [--show-prompt] NAME

  NAME            a directory, or a repo id looked up in scripts/repos.local
                  then under $ANOIEU_REPOS, beside kanon, or under $HOME.
  --codex         run codex instead of claude
  --print         run non-interactively and print the result
  --show-prompt   run the local check and print the prompt; no assistant

Run this in kanon, pointed at the repository you are asking about.
USAGE
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --codex) AGENT=codex; shift ;;
    --claude) AGENT=claude; shift ;;
    --print) PRINT=1; shift ;;
    --show-prompt) SHOW=1; shift ;;
    -h|--help) usage ;;
    -*) echo "check_join_eo: unknown option $1" >&2; usage ;;
    *) [ -z "$NAME" ] || { echo "check_join_eo: one repository at a time" >&2; usage; }
       NAME="$1"; shift ;;
  esac
done
[ -n "$NAME" ] || usage

# Resolve the checkout without changing it or the mapping.
TARGET=""
if [ -d "$NAME" ]; then
  TARGET=$(cd "$NAME" && pwd)
elif [ -f "$REPOS_FILE" ]; then
  while IFS= read -r line; do
    case "${line#"${line%%[![:space:]]*}"}" in ''|'#'*) continue ;; esac
    id=${line%%[[:space:]]*}; path=${line#"$id"}
    path=${path#"${path%%[![:space:]]*}"}
    [ "$id" = "$NAME" ] || continue
    case "$path" in "~"*) path="$HOME${path#\~}" ;; esac
    [ -d "$path" ] && TARGET=$(cd "$path" && pwd)
    break
  done < "$REPOS_FILE"
fi
if [ -z "$TARGET" ]; then
  IFS=: read -r -a SEARCH_ROOTS <<< "${ANOIEU_REPOS:-}"
  for r in "${SEARCH_ROOTS[@]}" "$ROOT/.." "$HOME"; do
    [ -n "$r" ] || continue
    [ -d "$r/$NAME" ] && { TARGET=$(cd "$r/$NAME" && pwd); break; }
  done
fi
if [ -z "$TARGET" ]; then
  echo "check_join_eo: nothing called '$NAME' -- give a path, or add an entry to" >&2
  echo "               $REPOS_FILE" >&2
  exit 2
fi

REPORT_STATUS=0
REPORT=$(python3 "$ROOT/scripts/policy_check.py" --root "$TARGET" 2>&1) || REPORT_STATUS=$?
if [ "$REPORT_STATUS" -gt 1 ]; then
  printf '%s\n' "$REPORT" >&2
  exit "$REPORT_STATUS"
fi

read -r -d '' PROMPT <<PROMPT_END || true
Assess $NAME, checked out at $TARGET, against docs/policy.md in $ROOT.
Read only: change no files, stage nothing, open no topics, and send nothing.

The local policy checker exited with code $REPORT_STATUS. Its complete output:

$REPORT

Read the current README and the policy's joining requirements. Establish whether
the README actually declares membership before choosing an assessment:

  JOINED         declares membership and passes the applicable checks.
  MISCONFIGURED  declares membership but fails a check; quote the failure.
  NOT JOINED     does not declare membership; report any readiness obstacles
                 without treating joining as something this repository owes us.

The check measures repository form. It cannot establish consent, the quality of
the work, or whether CI passed at a particular commit. If its output conflicts
with what you read, identify the conflict instead of forcing a verdict.

Briefly say whether the maintenance note explains who does the work and what
supervision covers. A discussion file is optional; its absence is no defect.
Separate concrete issues in their tree from stale instructions or checker defects
on our side. Cite paths and passages, and suggest the smallest useful correction.
Checker implementation defects belong to anoieu; policy and instruction defects
belong here. Report suggestions for a person to review; implement none of them.

PROMPT_END

if [ "$SHOW" = 1 ]; then printf '%s\n' "$PROMPT"; exit 0; fi

command -v "$AGENT" >/dev/null 2>&1 || {
  echo "check_join_eo: $AGENT is not on PATH" >&2; exit 127; }

echo "-- check_join_eo: $NAME ($TARGET), via $AGENT" >&2

cd "$ROOT"
if [ "$AGENT" = codex ]; then
  if [ "$PRINT" = 1 ]; then exec codex exec "$PROMPT"; else exec codex "$PROMPT"; fi
else
  if [ "$PRINT" = 1 ]; then exec claude -p "$PROMPT"; else exec claude "$PROMPT"; fi
fi
