#!/usr/bin/env bash
# global_audit -- ask an assistant to interpret the existing local status report.
# --show-prompt collects the same read-only report but launches no assistant.

set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
INVENTORY="$ROOT/scripts/ecosystem/ecosystem.json"
AGENT=claude
PRINT=0
SHOW=0

usage() {
  cat >&2 <<'USAGE'
usage: global_audit [--codex] [--print] [--show-prompt]

  --codex         run codex instead of claude
  --print         run non-interactively and print the result
  --show-prompt   collect local status and print the prompt; no assistant
USAGE
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --codex) AGENT=codex; shift ;;
    --claude) AGENT=claude; shift ;;
    --print) PRINT=1; shift ;;
    --show-prompt) SHOW=1; shift ;;
    -h|--help) usage ;;
    *) echo "global_audit: unknown option $1" >&2; usage ;;
  esac
done

# Use the same discovery, exclusions and diagnostics as the ordinary command.
# Collection errors stop here; individual unavailable checks remain visible.
INVENTORY_TEXT=$(cat "$INVENTORY")
REPORTS=$("$ROOT/scripts/status_eo" --all --verbose)

read -r -d '' PROMPT <<PROMPT_END || true
Review the Eunoia ecosystem using this local status report. Work from $ROOT.
Read only: change no files, stage nothing, open no topics, and send nothing.

Recorded inventory (a maintained record, not independent evidence):

$INVENTORY_TEXT

Output of scripts/status_eo --all --verbose:

$REPORTS

Summarize observed policy failures, inventory disagreements and unavailable
checks. Preserve the distinction between a recorded footing, a checkout result,
and an unverified claim. Candidates have not joined; associates and outsiders
are not held to the policy. A passing policy check establishes repository form,
not tool quality, consent, or passing CI.

Cite the evidence for each issue and suggest a useful next step. Identify stale
instructions on our side separately from issues in another repository. Report
checker defects for anoieu, which owns the checker. Do not infer performance,
vision compliance, grades, or rankings from this report; it contains no such
evidence. Keep the answer short and leave decisions to a person.

PROMPT_END

if [ "$SHOW" = 1 ]; then printf '%s\n' "$PROMPT"; exit 0; fi

command -v "$AGENT" >/dev/null 2>&1 || {
  echo "global_audit: $AGENT is not on PATH" >&2; exit 127; }

echo "-- global_audit: local status review, via $AGENT" >&2

cd "$ROOT"
if [ "$AGENT" = codex ]; then
  if [ "$PRINT" = 1 ]; then exec codex exec "$PROMPT"; else exec codex "$PROMPT"; fi
else
  if [ "$PRINT" = 1 ]; then exec claude -p "$PROMPT"; else exec claude "$PROMPT"; fi
fi
